public final class angle {
	int Agl;
	
	
	public angle(int i) {
		Agl= i;
	}
	public int getAgl() {
		return Agl;
	}
	public void setAgl(int i) {
		Agl= i;
	}
	public angle addAgl(angle rbt, angle palais) {
		if(rbt.getAgl()+palais.getAgl()<=360) 
			return new angle(rbt.getAgl()+palais.getAgl());		
		else {
			int f =rbt.getAgl()+palais.getAgl();
			angle F = new angle(f);
			return F;
		}}
	public angle sousAgl(angle rbt, angle palais) {
		if(rbt.getAgl()-palais.getAgl()>=0) 
			return new angle(rbt.getAgl()-palais.getAgl());		
		else {
			int f =rbt.getAgl()-palais.getAgl()+360;
			angle F = new angle(f);
			return F;}
	}
	

